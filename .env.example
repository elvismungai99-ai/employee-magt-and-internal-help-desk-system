# ==============================================================================
# ENVIRONMENT CONFIGURATION BLUEPRINT
# ==============================================================================

# Backend Server
PORT=8080
DB_URL=jdbc:postgresql://localhost:5432/leave_mgt_db?currentSchema=identity,leave,public
DB_USERNAME=postgres
DB_PASSWORD=

# JWT Secrets & Security
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000
BCRYPT_STRENGTH=12

# Application Settings
APP_TIMEZONE=Africa/Nairobi
FRONTEND_BASE_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
CORS_MAX_AGE_SECONDS=3600

# Registration & Security Rate Limiting
REQUIRE_REGISTRATION_APPROVAL=true
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_DURATION_MINUTES=15
RATE_LIMITER_MAX_ENTRIES=10000

# Initial Admin Seeding (set SEED_ADMIN_USER=true to seed on startup)
SEED_ADMIN_USER=false
ADMIN_EMAIL=hr.admin@company.com
ADMIN_PASSWORD=Admin123!
ADMIN_EMPLOYEE_CODE=EMP-00001
ADMIN_FIRST_NAME=System
ADMIN_LAST_NAME=Admin
ADMIN_JOB_TITLE=HR Administrator
ADMIN_PHONE=+254700000000

# Helpdesk Upload Limits & Storage
MAX_ATTACHMENT_SIZE_BYTES=10485760
ALLOWED_ATTACHMENT_EXTENSIONS=pdf,png,jpg,jpeg,gif,webp,txt,csv,doc,docx,xls,xlsx,zip
ATTACHMENT_STORAGE_DIR=uploads/tickets

# Server & Pool Sizing
HIKARI_MAX_POOL_SIZE=20
HIKARI_MIN_IDLE=5
TOMCAT_MAX_THREADS=100

# Notifications
SLACK_WEBHOOK_URL=
MAIL_FROM=noreply@company.com

# Scheduled Engines
SLA_MONITOR_RATE_MS=60000
ACCRUAL_CRON=0 0 1 1 * *
OUTBOX_POLL_INTERVAL_MS=5000

# Frontend Settings
VITE_BACKEND_URL=http://localhost:8080
VITE_PORT=5173
