{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Maven: Build All Microservices",
            "type": "shell",
            "command": "mvn clean install -DskipTests",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Maven: Compile All",
            "type": "shell",
            "command": "mvn compile",
            "group": "build",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Maven: Run Tests",
            "type": "shell",
            "command": "mvn test",
            "group": "test",
            "problemMatcher": "$msCompile"
        }
    ]
}
